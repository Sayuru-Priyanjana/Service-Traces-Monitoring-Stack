# Copy to .env and edit. deploy.sh refuses to run while values still say "change-me".

# Private IP of this server that the application servers can reach. OTLP (4317/4318) listens here.
OTLP_BIND_IP=10.0.0.10

# Grafana (HTTPS). Use 0.0.0.0 for all interfaces, or a single IP.
GRAFANA_BIND_IP=0.0.0.0
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=https://grafana.example.com:3000/
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Self-signed certificate created by deploy.sh when certs/grafana.crt is missing.
# Put your own grafana.crt / grafana.key into certs/ to use a real certificate instead.
GRAFANA_CERT_CN=grafana.example.com
GRAFANA_CERT_SANS=DNS:grafana.example.com,IP:10.0.0.10

# Prometheus retention: whichever limit is reached first wins.
PROM_RETENTION_TIME=30d
PROM_RETENTION_SIZE=50GB

# Used in alert notification links.
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093

# Firewall (scripts/firewall-monitoring.sh): space-separated sources allowed to reach the
# published Docker ports. Docker-published ports bypass ufw, so this is enforced in DOCKER-USER.
OTLP_ALLOWED_SOURCES="10.0.0.11 10.0.0.12"
GRAFANA_ALLOWED_SOURCES="10.0.0.0/8"
