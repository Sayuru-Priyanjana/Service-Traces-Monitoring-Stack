# All settings for the production deployment, in one file.
# Copy to deploy/.env on every server and edit:  cp .env.example .env && chmod 600 .env
# Used by monitoring/deploy.sh, agent/deploy.sh and scripts/firewall-*.sh. The deploy
# scripts link monitoring/.env and agent/.env to this file, so `docker compose` commands
# run in those folders use it too.
#
# The SHARED section must be identical on every server. The PER-SERVER section differs:
# set it for the server this copy is on.

# ===========================================================================
# SHARED: same on every server
# ===========================================================================

DEPLOYMENT_ENVIRONMENT=production

# Private IP of the monitoring server. Its gateway collector listens for OTLP on this IP.
# Must be a specific IP, not 0.0.0.0 (the agent on the same server uses 127.0.0.1:4317).
OTLP_BIND_IP=10.0.0.10

# Where the agents send OTLP: the monitoring server's OTLP_BIND_IP, port 4317.
GATEWAY_OTLP_ENDPOINT=10.0.0.10:4317
# true = plain gRPC (private network). Set false once the gateway has TLS configured.
GATEWAY_TLS_INSECURE=true

# Who may scrape the exporters (9100, 9256) on each server: the monitoring server.
MONITORING_SOURCES="10.0.0.10"

# ===========================================================================
# PER-SERVER: agent (every server, including the monitoring server)
# ===========================================================================

# Name of this server in the dashboards (Host filter). Must equal the `instance` label
# given to this server in monitoring/prometheus/targets/*.yml.
HOST_NAME=app1

# This server's private IP: the exporters listen here (or 0.0.0.0).
EXPORTER_BIND_IP=10.0.0.11

# systemd units reported by node-exporter (regex). List the services this server runs.
SYSTEMD_UNITS='(nginx|redis-server|orders|inventory|ssh)\.service'

# "otel" starts the OTel agent collector (apps send to 127.0.0.1:4317). Keep it on the
# monitoring server too. Set it empty only if no instrumented app runs on this server.
COMPOSE_PROFILES=otel

# Local ports the apps send OTLP to (127.0.0.1 only).
AGENT_OTLP_GRPC_PORT=4317
AGENT_OTLP_HTTP_PORT=4318

# ===========================================================================
# MONITORING SERVER ONLY (ignored by the agent; may keep "change-me" on app servers)
# ===========================================================================

# Grafana (HTTPS). Use 0.0.0.0 for all interfaces, or a single IP.
GRAFANA_BIND_IP=0.0.0.0
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=https://grafana.example.com:3000/
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Self-signed certificate created by monitoring/deploy.sh when certs/grafana.crt is missing.
# Put your own grafana.crt / grafana.key into monitoring/certs/ to use a real certificate.
GRAFANA_CERT_CN=grafana.example.com
GRAFANA_CERT_SANS=DNS:grafana.example.com,IP:10.0.0.10

# Prometheus retention: whichever limit is reached first wins.
PROM_RETENTION_TIME=30d
PROM_RETENTION_SIZE=50GB

# Used in alert notification links.
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093

# Firewall (scripts/firewall-monitoring.sh): space-separated sources allowed to reach the
# published Docker ports. Docker-published ports bypass ufw, so this is enforced in DOCKER-USER.
OTLP_ALLOWED_SOURCES="10.0.0.11 10.0.0.12"
GRAFANA_ALLOWED_SOURCES="10.0.0.0/8"
