# Copy to .env on each server and edit.

# Name of this server in the dashboards (Host filter). Must equal the `instance` label
# given to this server in the monitoring server's prometheus/targets/*.yml.
HOST_NAME=app1
DEPLOYMENT_ENVIRONMENT=production

# Address the exporters listen on: this server's private IP (or 0.0.0.0).
# Prometheus on the monitoring server scrapes <this IP>:9100 and :9256.
EXPORTER_BIND_IP=10.0.0.11

# systemd units reported by node-exporter (regex). List the services you run.
SYSTEMD_UNITS='(nginx|redis-server|orders|inventory|ssh)\.service'

# "otel" starts the OTel agent collector (apps send to 127.0.0.1:4317). Keep it on the server
# that also runs the monitoring stack too: the gateway listens on OTLP_BIND_IP, the agent on
# 127.0.0.1, so they don't clash (as long as OTLP_BIND_IP is not 0.0.0.0).
# Set it empty only if no instrumented app runs on this server.
COMPOSE_PROFILES=otel

# Gateway collector on the monitoring server (its OTLP_BIND_IP).
GATEWAY_OTLP_ENDPOINT=10.0.0.10:4317
# true = plain gRPC (private network). Set false once the gateway has TLS configured.
GATEWAY_TLS_INSECURE=true

# Local ports the apps send OTLP to (127.0.0.1 only).
AGENT_OTLP_GRPC_PORT=4317
AGENT_OTLP_HTTP_PORT=4318

# Firewall (../scripts/firewall-agent.sh): who may scrape the exporters.
MONITORING_SOURCES="10.0.0.10"
