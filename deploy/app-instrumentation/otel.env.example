# OpenTelemetry settings for one application service.
# Install as /etc/otel/<service>.env and reference it from the service's systemd unit:
#   [Service]
#   EnvironmentFile=/etc/otel/<service>.env
# (or pass it with `env_file:` / `--env-file` if the app runs in Docker on the host network).

# Must match the process-exporter group and the systemd unit name (without .service).
OTEL_SERVICE_NAME=orders
OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0

# The local agent collector (deploy/agent) - also on the server that runs the monitoring stack.
# host.name and deployment.environment are added by the agent.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
# W3C trace context + baggage, so traces continue across services and user.action travels along.
OTEL_PROPAGATORS=tracecontext,baggage
# Push metrics every 15 s (matches the Prometheus scrape interval; SDK default is 60 s).
OTEL_METRIC_EXPORT_INTERVAL=15000
# Sample everything at the source; sampling decisions are made centrally (gateway tail_sampling).
OTEL_TRACES_SAMPLER=parentbased_always_on

# Python only: don't trace health checks.
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=/health
