# Linux-side files must keep LF endings: CRLF breaks bash, systemd and YAML parsing.
* text=auto
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.json      text eol=lf
*.txt       text eol=lf
*.default   text eol=lf
Vagrantfile text eol=lf
# PowerShell scripts are run on Windows
*.ps1       text eol=crlf
